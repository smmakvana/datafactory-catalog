<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.paramichha</groupId>
        <artifactId>paramichha-dev</artifactId>
        <version>1.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>paramichha-example</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Paramichha Example</name>
    <description>
        Example fixture classes for Paramichha DataFactory and TestKit.
        Provides realistic Jakarta-annotated POJOs, records, and Lombok classes
        covering all supported types, annotations, and assembly strategies.
        Use as a test-scope dependency to get ready-made annotated fixtures.
    </description>
    <url>https://paramichha.com</url>

    <scm>
        <connection>scm:git:git://github.com/smmakvana/paramichha-example.git</connection>
        <developerConnection>scm:git:ssh://github.com/smmakvana/paramichha-example.git</developerConnection>
        <url>https://github.com/smmakvana/paramichha-example</url>
        <tag>HEAD</tag>
    </scm>

    <dependencies>

        <!-- Jakarta validation — annotations on fixture classes -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>

        <!-- Hibernate Validator — needed to run validation on fixture instances -->
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
        </dependency>

        <!-- EL implementation required by Hibernate Validator -->
        <dependency>
            <groupId>org.glassfish.expressly</groupId>
            <artifactId>expressly</artifactId>
        </dependency>

        <!-- Lombok — @Value @Builder @AllArgsConstructor on fixture classes -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- Hibernate Validator extra constraints — @CreditCardNumber @EAN @ISBN @URL @Length -->
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
